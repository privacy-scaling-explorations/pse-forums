{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "yarn install --ignore-optional --network-timeout 1000000",
        "buildCommand": "ROLLUP_SKIP_NATIVES=true NODE_OPTIONS=--no-experimental-fetch yarn build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NODE_OPTIONS": "--no-experimental-fetch",
    "ROLLUP_SKIP_NATIVES": "true"
  }
}
